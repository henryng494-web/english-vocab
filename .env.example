# Copy to .env.local (local) and mirror these in Vercel -> Project Settings -> Environment Variables.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed for DB writes (batch scripts, cron, persisting repairs/new words).
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (required for scripts and on-demand new words) ---
GEMINI_API_KEY=
# Optional: comma-separated key pool, rotated on 429/402 (takes precedence over GEMINI_API_KEY).
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TRANSLATION_MODEL=gemini-flash-lite-latest
# Realtime Gemini is OFF by default inside the Next server (production).
# Only set to 0/false to re-enable it; scripts (npm run ...) are unaffected.
DISABLE_REALTIME_GEMINI=
# Set to 1 to also close the on-demand new-word exception in /api/discover/word.
DISABLE_ON_DEMAND_NEW_WORD=
ON_DEMAND_WORDS_PER_MINUTE=6
ON_DEMAND_WORDS_GLOBAL_PER_MINUTE=40

# --- Cron (required if /api/cron/re-enrich-stale is scheduled) ---
CRON_SECRET=

# --- Stock images (optional) ---
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
