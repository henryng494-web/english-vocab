{
  "name": "english-vocab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:mobile": "node scripts/build-mobile.mjs",
    "cap:sync": "npx cap sync",
    "build:check": "NEXT_DIST_DIR=.next-check next build",
    "verify": "npm run typecheck && npm run lint",
    "db:migrate:multilang": "npx tsx scripts/apply-word-details-multilang-migration.ts",
    "generate:subtlex": "node scripts/generate-subtlex-ranks.mjs",
    "generate:proper-nouns": "node scripts/generate-proper-nouns.mjs",
    "generate:keywords": "npx tsx scripts/generate-curated-keywords.ts",
    "generate:mascot-manifest": "npx tsx scripts/generate-mascot-scene-manifest.ts",
    "extract:mascot-sprites": "python3 scripts/extract-mascot-sprites.py",
    "render:cast-word-images": "python3 scripts/render-cast-word-images.py",
    "generate:cast-word-images": "npx tsx scripts/generate-cast-word-images.ts",
    "generate:cast-word-images:101-150": "npx tsx scripts/generate-cast-word-images-rank-range.ts 101 150",
    "rebuild:jungle-semantic-prompts": "npx tsx scripts/rebuild-jungle-semantic-prompts.ts",
    "export:jungle-cast-framework": "npx tsx scripts/export-jungle-cast-framework.ts",
    "build:jungle-casts-101-150": "npx tsx scripts/build-jungle-casts-rank-101-150.ts",
    "build:jungle-casts-151-160": "npx tsx scripts/build-jungle-casts-rank-151-160.ts",
    "build:jungle-casts-161-300": "npx tsx scripts/build-jungle-casts-rank-161-300.ts",
    "build:jungle-casts-301-500": "npx tsx scripts/build-jungle-casts-rank-301-500.ts",
    "build:jungle-casts-501-1000": "npx tsx scripts/build-jungle-casts-rank-501-1000.ts",
    "build:jungle-casts-1001-2999": "npx tsx scripts/build-jungle-casts-rank-1001-2999.ts",
    "build:jungle-casts-3000-3500": "npx tsx scripts/build-jungle-casts-rank-3000-3500.ts",
    "build:jungle-casts-3501-5000": "npx tsx scripts/build-jungle-casts-rank-3501-5000.ts",
    "build:jungle-casts-5001-6000": "npx tsx scripts/build-jungle-casts-rank-5001-6000.ts",
    "jungle13:copy-all": "npx tsx scripts/jungle13-copy-all.ts",
    "jungle14:copy-all": "npx tsx scripts/jungle14-copy-all.ts",
    "jungle15:copy-all": "npx tsx scripts/jungle15-copy-all.ts",
    "jungle16:copy-all": "npx tsx scripts/jungle16-copy-all.ts",
    "jungle17:copy-all": "npx tsx scripts/jungle17-copy-all.ts",
    "jungle18:copy-all": "npx tsx scripts/jungle18-copy-all.ts",
    "detect:pollinations-cast-images": "npx tsx scripts/detect-pollinations-cast-images.ts",
    "jungle:gen-args": "npx tsx scripts/jungle-gen-args.ts",
    "scan:jungle-word-images": "npx tsx scripts/scan-jungle-word-images.ts",
    "fix:jungle-word-images": "npx tsx scripts/fix-jungle-word-images.ts",
    "qa:jungle-word-images": "npx tsx scripts/qa-fix-jungle-loop.ts",
    "copy:cast-artifacts": "bash scripts/copy-cast-artifacts.sh",
    "test:gemini-unsplash-image": "npx tsx scripts/test-gemini-unsplash-image.ts",
    "test:gemini-pexels-image": "npm run test:gemini-unsplash-image",
    "test:pexels": "npx tsx scripts/test-pexels-keywords.ts",
    "backfill:images": "npx tsx scripts/backfill-stock-images.ts",
    "refresh:all-images": "npm run backfill:images -- --force",
    "translate:all-es": "npx tsx scripts/translate-all-words-es.ts",
    "backfill:translations": "bash scripts/run-backfill-translations.sh",
    "backfill:translations:free": "GEMINI_FREE_TIER=1 GEMINI_MAX_RPM=15 CONCURRENCY=1 BATCH_DELAY_MS=0 LOCALE_DELAY_MS=0 npx tsx scripts/backfill-translations.ts",
    "backfill:translations:free:sequential": "bash scripts/run-backfill-translations-free-sequential.sh",
    "enrich:new-words": "npx tsx scripts/enrich-new-words.ts",
    "enrich:similar-words": "GEMINI_TRANSLATION_MODEL=${GEMINI_TRANSLATION_MODEL:-gemini-flash-lite-latest} npx tsx scripts/enrich-similar-words.ts",
    "export:cast-word-keys": "npx tsx scripts/export-cast-word-keys.ts",
    "export:preset-rank-map": "npx tsx scripts/export-preset-rank-map.ts",
    "enrich:repair": "npx tsx scripts/enrich-repair.ts",
    "re-enrich:stale": "npx tsx scripts/re-enrich-stale-words.ts",
    "re-enrich:all": "npx tsx scripts/re-enrich-stale-all.ts",
    "backfill:register": "npx tsx scripts/backfill-register-offline.ts",
    "audit:meanings": "npx tsx scripts/audit-meaning-quality.ts",
    "re-enrich:formal": "npx tsx scripts/re-enrich-stale-words.ts -- --formal-only",
    "audit:subtlex-noise": "npx tsx scripts/audit-subtlex-noise.ts",
    "audit:vocab-abbreviations": "npx tsx scripts/audit-vocab-abbreviations.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@google/generative-ai": "^0.24.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "edge-tts-universal": "^1.4.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "subtlex-word-frequencies": "^2.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.4",
    "pg": "^8.16.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.2"
  }
}
